# Kopjo këtë skedar si ".env" dhe vendos vlerat reale.
# KUJDES: .env NUK duhet të futet kurrë në Git (është në .gitignore).

# Porta e serverit
PORT=3000

# Rruga e databazës SQLite (krijohet automatikisht në nisje)
DB_PATH=./data/parking.db

# Administratori fillestar (krijohet vetëm nëse nuk ekziston asnjë admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=e1234567

# Çelësi API për urën e Arduino-s (bridge).
# Nëse lihet bosh, gjenerohet një çelës i ri nga "npm run seed" dhe shfaqet VETËM një herë.
# Në databazë ruhet vetëm hash-i i tij.
BRIDGE_API_KEY=

# Kohëzgjatja e sesionit të adminit në orë
SESSION_TTL_HOURS=12
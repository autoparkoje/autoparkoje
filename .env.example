# Kopjo këtë skedar si ".env" në rrënjën e repo-s dhe vendos vlerat reale.
# Përdoret nga docker-compose.yml. KURRË mos e fut .env në Git.

# Porta ku ekspozohet aplikacioni në host
PORT=3000

# Administratori fillestar (krijohet vetëm nëse nuk ekziston asnjë admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ndrysho-kete-fjalekalim

# Çelësi API i urës së Arduino-s. Nëse lihet bosh, gjenerohet një i ri në
# nisjen e parë dhe shfaqet VETËM një herë në logje: docker compose logs backend
BRIDGE_API_KEY=

# Kohëzgjatja e sesionit të adminit (orë)
SESSION_TTL_HOURS=12

# URL-ja publike e faqes në prodhim — përdoret në kodet QR që ato të hapen
# nga telefonat (kamera native iPhone/Android). Bosh = zhvillim lokal
# (QR-të ndërtohen nga adresa aktuale e shfletuesit).
PUBLIC_BASE_URL=https://autoparkoje.onrender.com

# Pragjet e klasifikimit të distancës (cm) — përputhen me firmware-in
OCC_THRESHOLD_CM=3
MAX_RANGE_CM=10